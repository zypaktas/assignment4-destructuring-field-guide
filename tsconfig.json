{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": [
    "ts/**/*.ts",
    "ts/**/*.tsx",
    "js/**/*.jsx"
  ]
}
